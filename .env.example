# ===== Crescent Cafe backend: every variable the app reads. Copy to .env (local) or set in Render's dashboard. NEVER commit real values.

# --- general
APP_NAME=Crescent Cafe API
DEBUG=false
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
PUBLIC_BASE_URL=http://localhost:8000      # public URL of THIS API (used for Cashfree webhook notify_url and local media URLs)
FRONTEND_URL=                                  # website base URL (https, no trailing slash). Razorpay's redirect-mode callback sends customers back here. Empty = QR_SITE_URL
QR_SITE_URL=http://localhost:3000          # QR ordering website / Android App Link host. QR codes encode {QR_SITE_URL}/t/{token}
CORS_ORIGINS=http://localhost:3000         # comma separated origins allowed to call the API from a browser (QR website)
DIAGNOSTICS_TOKEN=                         # optional secret for GET /api/v1/diagnostics (an admin JWT also works)

# --- database: Supabase PostgreSQL (Project Settings -> Database -> Connection string)
# Use the SESSION pooler (port 5432) or direct connection. postgres:// or postgresql:// prefixes are converted automatically.
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_USE_PGBOUNCER=true                      # keep true for Supabase poolers (disables asyncpg prepared statements)
DB_SSL_REQUIRE=true                        # Supabase requires TLS

# --- auth
JWT_ALGORITHM=HS256
JWT_SECRET=                                # REQUIRED in production: 64+ random chars (python -c "import secrets;print(secrets.token_urlsafe(64))")
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
TABLE_SESSION_TOKEN_MINUTES=240
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

# --- first admin (read ONLY by `python -m scripts.bootstrap_admin`; remove after bootstrapping)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Cafe Admin
BRANCH_CODE=main
BRANCH_NAME=Crescent Cafe

# --- Google Sign-In for customers (comma separated). Put the WEB client ID here: the website and the Android app (native Credential Manager, serverClientId) both obtain tokens for it.
GOOGLE_CLIENT_IDS=

# --- Redis (optional): shared rate limits + WebSocket fan-out across multiple instances. Leave empty on a single instance.
REDIS_URL=

# --- Razorpay (server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# --- Cashfree (server-side only)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=                   # optional; Cashfree signs webhooks with the client secret
CASHFREE_ENV=sandbox                       # sandbox | production
CASHFREE_API_VERSION=2023-08-01
CASHFREE_RETURN_URL=http://localhost:3000/payments/cashfree-return  # return page; backend appends the order_id query parameter
PAYMENT_TIMEOUT_MINUTES=20

# --- Firebase Cloud Messaging (push only). Paste the service-account JSON (raw or base64). Never ship it in an APK.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=                 # alternative for local development
FCM_ANDROID_CHANNEL_NEW_ORDER=new_orders
FCM_ANDROID_CHANNEL_DEFAULT=general
FCM_ANDROID_CHANNEL_ORDER_UPDATES=order_updates
FCM_ANDROID_CHANNEL_MESSAGES=messages
FCM_ANDROID_CHANNEL_DELIVERY=delivery_updates
FCM_ANDROID_CHANNEL_PROMOTIONS=promotions
FCM_ANDROID_CHANNEL_PAYMENTS=payments
FCM_DRY_RUN=false

# --- Menu image storage (Supabase Storage; bucket must be PUBLIC)
STORAGE_BACKEND=local                     # local for development; use supabase (durable) in production
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                 # server-side secret; never expose to clients
SUPABASE_STORAGE_BUCKET=menu-images
LOCAL_MEDIA_DIR=./media
MAX_IMAGE_BYTES=5242880

# --- background jobs (Postgres queue; no extra paid service)
EMBEDDED_WORKER=true                       # run the worker inside the API process. Set false if you run scripts/run_worker.py separately
JOB_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=8

RATE_LIMIT_ENABLED=true
DEFAULT_TIMEZONE=Asia/Kolkata


# ---- e-mail via Resend (https://resend.com). Server-side only: never put this key in the website or the Android app.
RESEND_API_KEY=                          # re_xxxxxxxx  (empty = e-mails are skipped with a log line, nothing breaks)
EMAIL_FROM=Crescent Cafe <noreply@yourdomain.com>   # must be on a domain you verified in Resend
EMAIL_REPLY_TO=

# ---- password reset by e-mailed OTP
PASSWORD_RESET_OTP_DIGITS=4              # you asked for 4; 6 is safer against guessing (set 6 to switch)
PASSWORD_RESET_OTP_MINUTES=5
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_PER_HOUR=5

# ---- delivery rules
REQUIRE_PAYMENT_BEFORE_DELIVERY=true     # rider must record cash / see the QR paid before the customer's OTP can finish the delivery
ARRIVAL_NOTIFY_DISTANCE_M=100            # "rider is nearby" alert distance in metres (phone GPS is often 5-30 m off)

# ---- location / address lookup (Nominatim-compatible; the public OSM server is fine for a small cafe)
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=CrescentCafe/1.0 (you@example.com)   # OSM requires a real contact in the User-Agent
GEOCODER_API_KEY=                        # only for providers like LocationIQ
GEOCODER_COUNTRY_CODES=in
RIDER_QR_MINUTES=10

# ---- proxies
TRUSTED_PROXY_COUNT=1                    # Render = 1. Use 0 when the API is not behind a proxy.
